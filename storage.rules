rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Profile pictures
    match /profilePictures/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null &&
                   request.auth.uid == userId;
    }

    // News images
    match /news/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Sermons
    match /sermons/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Live broadcasts thumbnails
    match /live/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
